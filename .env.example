# =============================================================================
# Phase 1–2 — public / build-time vars (safe to include in server bundles)
# =============================================================================

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# Unicorn Studio WebGL (optional)
NEXT_PUBLIC_UNICORN_PROJECT_ID=

# GitHub sign-in button — set to "1" only after X-05 (OAuth app) is approved
NEXT_PUBLIC_GITHUB_ENABLED=0

# Newsletter feature flag — set to "1" to enable (default: disabled)
NEWSLETTER_ENABLED=0

# Dev-only routes (/dev/*). Keep unset in production.
ENABLE_DEV_ROUTES=

# =============================================================================
# Phase 3 — server-only secrets (never expose to client)
# =============================================================================

# Database
DATABASE_URL=mysql://studio_user:studiopassword@localhost:3306/andypratama_studio

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Better Auth client (browser) — falls back to NEXT_PUBLIC_SITE_URL when unset
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Owner identity — only this email may create a session / sign up
OWNER_EMAIL=andypratamaworkspace@gmail.com

# Owner Auth (GitHub OAuth)
OWNER_GITHUB_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# One-time owner bootstrap (/api/owner/bootstrap). Blank disables the route.
# Generate: openssl rand -hex 24
OWNER_SETUP_TOKEN=

# Development-only dashboard bypass. Never set in production.
DASHBOARD_DEV_BYPASS=

# Agent task API (/api/agent/tasks) uses per-agent keys, not a shared secret.
# Issue one with: pnpm agent:key <agent-slug>   (revoke: ... --revoke)

# Unicorn Studio (server fallback, no NEXT_PUBLIC_ prefix)
UNICORN_PROJECT_ID=

# Contact & Lead notification
CONTACT_EMAIL=contact@andypratama.studio
LEAD_NOTIFY_TO=

# SMTP (leave blank to use file transport in dev/test; required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@andypratama.studio

# Mail transport: "file" (dev log) or "smtp" (production)
# Defaults to "file" when SMTP_HOST is absent.
MAIL_TRANSPORT=file
